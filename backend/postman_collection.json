              ],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Paginated products (10 per page). Query rules: search optional string max 100 chars (name contains); category_id optional integer; page integer min 1. Saves the first product id to product_id."
          }
        },
        {
          "name": "Product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
